{
  "source": "https://unmarkai.cn/openapi-v1.yaml",
  "retrieved": "2026-11-16",
  "openapi": "3.1.0",
  "info": {
    "title": "UnmarkAI Video API",
    "version": "1.3.0",
    "description": "UnmarkAI 视频文字移除与视频翻译公共 API，以及向客户 endpoint 投递的 Webhook 事件契约。\n\n`/v1/*` 使用 `uma_live_*` API key，成功时直接返回资源，失败时返回\n`error.code/error.message/error.request_id`。公共 API 的 JSON 请求体最大为\n翻译创建为 512 KiB，其他请求为 64 KiB；超限返回 413。\n"
  },
  "servers": [
    {
      "url": "https://api.unmarkai.net",
      "description": "Overseas production"
    },
    {
      "url": "https://unmarkai.cn/api",
      "description": "Mainland China production"
    }
  ],
  "components": {
    "schemas": {
      "VideoUpscaleCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "input",
          "upscale"
        ],
        "properties": {
          "type": {
            "const": "video_upscale"
          },
          "input": {
            "$ref": "#/components/schemas/JobInput"
          },
          "upscale": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target"
            ],
            "properties": {
              "target": {
                "type": "string",
                "enum": [
                  "1080p",
                  "2k",
                  "4k"
                ]
              }
            }
          },
          "metadata": {
            "type": "object",
            "description": "客户元数据，最多16 KB。"
          }
        },
        "description": "中国区视频高清。1080p/2K/4K 标准价每秒人民币0.04/0.08/0.12元；服务端探测平均帧率，大于30 FPS翻倍，再应用充值折扣。最低15秒，向上取整到整秒；保留画面比例、帧率和音轨，无平台水印。"
      },
      "JobInput": {
        "type": "object",
        "required": [
          "upload_id"
        ],
        "properties": {
          "upload_id": {
            "$ref": "#/components/schemas/ResourceId"
          }
        }
      },
      "UploadCreateRequest": {
        "type": "object",
        "required": [
          "filename",
          "content_type",
          "file_size_bytes"
        ],
        "properties": {
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "单个文件名，不允许路径分隔符或控制字符"
          },
          "content_type": {
            "type": "string",
            "enum": [
              "video/mp4",
              "video/quicktime",
              "video/x-msvideo",
              "video/x-matroska",
              "video/webm",
              "video/mpeg"
            ]
          },
          "file_size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483648
          }
        }
      },
      "ResourceId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "validating",
          "queued",
          "processing",
          "succeeded",
          "failed",
          "canceled"
        ]
      },
      "JobResult": {
        "type": "object",
        "required": [
          "url",
          "expires_at"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "最多有效 1 小时的签名下载 URL"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "当前签名 URL 的过期时间"
          }
        }
      },
      "RemoveTextJobCreateRequest": {
        "type": "object",
        "required": [
          "type",
          "input",
          "mode"
        ],
        "description": "`mode=sel_area` 时 `rect` 为单个矩形，面积不得超过源画面的一半；\n`mode=multi_area` 时 `rect` 为非空矩形数组，每个矩形须在源画面内，按 all_area 费率计费；\n`mode=all_area` 时 `rect` 必须省略或为 null。\nmetadata 序列化后的 UTF-8 大小不得超过 16 KiB。\n",
        "properties": {
          "type": {
            "type": "string",
            "const": "remove_text"
          },
          "input": {
            "$ref": "#/components/schemas/JobInput"
          },
          "mode": {
            "$ref": "#/components/schemas/JobMode"
          },
          "rect": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Rect"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/components/schemas/Rect"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "metadata": {
            "type": "object",
            "default": null,
            "additionalProperties": true
          }
        }
      },
      "JobMode": {
        "type": "string",
        "enum": [
          "all_area",
          "sel_area",
          "multi_area"
        ]
      },
      "Rect": {
        "type": "object",
        "required": [
          "x1",
          "y1",
          "x2",
          "y2"
        ],
        "description": "源视频绝对像素坐标；要求 x1 < x2、y1 < y2",
        "properties": {
          "x1": {
            "type": "number",
            "minimum": 0
          },
          "y1": {
            "type": "number",
            "minimum": 0
          },
          "x2": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "y2": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
